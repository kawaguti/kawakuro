# ── 必須 ─────────────────────────────────────────
# Discord Developer Portal の Bot ページで発行したトークン
DISCORD_TOKEN=

# Botを入れるサーバーのID（サーバー名を右クリック →「サーバーIDをコピー」）
# 複数のサーバーで使うときはカンマ区切り。あなたが入ったボイスチャンネルのサーバーで喋る
GUILD_ID=

# あなた自身のユーザーID（自分を右クリック →「ユーザーIDをコピー」）
OWNER_USER_ID=

# ── 任意 ─────────────────────────────────────────
# 読み上げ対象にするテキストチャンネルのID。
# 空でも、Botが入っているボイスチャンネル内のチャットは常に読み上げます。
TEXT_CHANNEL_ID=

# あなた以外で読み上げを許可する投稿者のID（カンマ区切り）。
# Museのコネクタが使うBotのIDや、WebhookのIDをここに入れます。
ALLOWED_AUTHOR_IDS=

# このBot自身のトークンでMuseに投稿させる場合は true（自分の投稿も読む）
READ_OWN_MESSAGES=false

# あなたがボイスチャンネルに出入りしたら、Botも自動でついていく
AUTO_FOLLOW=true

# VOICEVOX の設定。声は「名前/スタイル」か話者IDの数字で指定（一覧は npm run voices）
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=No.7/アナウンス
VOICEVOX_SPEED=1.0

# 1メッセージで読み上げる最大文字数
MAX_LENGTH=200

# ── 受付モード ───────────────────────────────────
# MODE=reception にすると、決めたボイスチャンネルに居続け、
# 決めたテキストチャンネルでBot宛てにメンションされた文を、誰のものでも読み上げる。
# TEXT_CHANNEL_ID への投稿（あなたと許可した投稿者）も、同じボイスチャンネルで読む。空にすると分身モードに戻る。
MODE=
# Botが居続けるボイスチャンネルのID
RECEPTION_VOICE_CHANNEL_ID=
# メンションを受け付けるテキストチャンネルのID（カンマ区切り）。上のボイスチャンネル内のチャットは常に対象
RECEPTION_TEXT_CHANNEL_IDS=
# 同じ文を読む回数と、同じ人が続けて呼べるまでの秒数
RECEPTION_REPEAT=2
RECEPTION_COOLDOWN_SEC=10
# 受付の呼び出しだけ別の声にする（空なら VOICEVOX_SPEAKER と同じ声）
RECEPTION_VOICEVOX_SPEAKER=
# 受付の開始と終了を、受付のテキストチャンネルに書く（false で書かない）
RECEPTION_NOTICE=true
# クレジット表記。空なら声の名前から「VOICEVOX:名前」を作る。書き方が特別な声はここに書く
RECEPTION_CREDIT=
